+#[test]
+fn recursive_project_trust_preserves_nearest_entry_and_path_boundaries() {
+    let config = config_with_projects(&[
+        ("/home/jie", Some(TrustLevel::Trusted)),
+        ("/home/jie/blocked", Some(TrustLevel::Untrusted)),
+        ("/home/jie/unset", None),
+    ]);
+    for (path, expected) in [
+        ("/home/jie/repo/src", Some(Some(TrustLevel::Trusted))),
+        ("/home/jie/blocked/src", Some(Some(TrustLevel::Untrusted))),
+        ("/home/jie/unset/src", Some(None)),
+        ("/home/jie-other/repo", None),
+    ] {
+        let lookup = ProjectTrustLookup::from_paths(
+            PathConvention::Posix,
+            ProjectTrustPath {
+                original: path.into(),
+                canonical: None,
+            },
+            None,
+        );
+        assert_eq!(
+            config
+                .get_active_project_for_lookup(&lookup)
